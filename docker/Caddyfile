{
	servers {
		protocols h1 h2 h3
	}
}

valleynote.com, www.valleynote.com {
	encode zstd gzip

	# Immutable build assets — long cache, no revalidation
	@static path /_next/static/*
	header @static Cache-Control "public, max-age=31536000, immutable"

	@fonts path /fonts/*
	header @fonts Cache-Control "public, max-age=31536000, immutable"

	@media path /botwise/* /marketing/*
	header @media Cache-Control "public, max-age=2592000, immutable"

	@nextimage path /_next/image*
	header @nextimage Cache-Control "public, max-age=2592000, stale-while-revalidate=86400"

	reverse_proxy web:3000 {
		flush_interval -1
		transport http {
			keepalive 30s
			keepalive_idle_conns 32
		}
	}

	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	log {
		output stdout
		format console
		level ERROR
	}
}
