# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Database (Docker Compose defaults)
# Host ports 5433/6380 avoid clashes with other local stacks; containers still use 5432/6379 internally.
DATABASE_URL=postgresql://valleynote:valleynote@localhost:5433/valleynote?schema=public

# Redis
REDIS_URL=redis://localhost:6380

# Better Auth — generate with: openssl rand -base64 32
# Production: secret ≥32 chars; BETTER_AUTH_URL must be https://your-domain
BETTER_AUTH_SECRET=replace-with-a-long-random-secret
BETTER_AUTH_URL=http://localhost:3000
# Optional comma-separated extra origins (preview apps, www, etc.)
BETTER_AUTH_TRUSTED_ORIGINS=

# Optional: protect /api/health (Authorization: Bearer … or ?token=)
HEALTH_CHECK_TOKEN=

# Email (Resend) — leave RESEND_API_KEY blank in local to log links to console
# After verifying a domain in Resend, EMAIL_FROM must use that domain (not @resend.dev)
RESEND_API_KEY=
EMAIL_FROM="ValleyNote <noreply@valleynote.com>"

# AI — OpenRouter (recommended), or openai / anthropic
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_CHAT_MODEL=anthropic/claude-sonnet-4.5
AI_EMBEDDING_MODEL=openai/text-embedding-3-small
AI_TRANSCRIPTION_MODEL=openai/whisper-large-v3

# File storage (Cloudflare R2 / S3-compatible)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=valleynote
S3_PUBLIC_URL=

# Stripe (legacy / unused once Whop is live)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Whop payments — embedded checkout on your site
# Dashboard: https://whop.com/dashboard/developer
WHOP_ENVIRONMENT=production
WHOP_API_KEY=
WHOP_ACCOUNT_ID=
# Create webhook → /api/webhooks/whop (events: payment.succeeded, membership.activated, membership.updated)
WHOP_WEBHOOK_SECRET=
NEXT_PUBLIC_WHOP_PLAN_BASIC_MONTHLY=
NEXT_PUBLIC_WHOP_PLAN_BASIC_YEARLY=
NEXT_PUBLIC_WHOP_PLAN_PLUS_MONTHLY=
NEXT_PUBLIC_WHOP_PLAN_PLUS_YEARLY=
NEXT_PUBLIC_WHOP_PLAN_PRO_MONTHLY=
NEXT_PUBLIC_WHOP_PLAN_PRO_YEARLY=

# Feature flags
FEATURE_PRO_TRIAL=false
